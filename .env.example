# ===================================================
# MIXTAS FASHION STORE - ENVIRONMENT VARIABLES EXPORT
# ===================================================

# ---------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ---------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------
# 2. SUPABASE DATABASE & AUTHENTICATION
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
# ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=***REMOVED***
# Secret Service Role Key (Server-side operations only - NEVER prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=***REMOVED***
# ---------------------------------------------------
# 3. PAYMENT GATEWAY WEBHOOK SECURITY
# Configured in your payment provider's dashboard under Webhooks
# ---------------------------------------------------
PAYMENT_WEBHOOK_SECRET=your_custom_webhook_secret_hash_here

# ---------------------------------------------------
# 4. MOBILE MONEY & CARD PAYMENT GATEWAYS (CHOOSE YOUR PROVIDER)
# ---------------------------------------------------

# OPTION A: FLUTTERWAVE (Recommended for MTN MoMo + Orange Money + Cards)
# Obtain from: https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_REMOVED
FLUTTERWAVE_SECRET_KEY=FLWSECK_REMOVED
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_REMOVED

# OPTION B: NOTCHPAY (Cameroon / Central Africa Mobile Money)
# Obtain from: https://dashboard.notchpay.co/settings/api
NOTCHPAY_PUBLIC_KEY=pk_test.6T25Z90rDqK6osrKbk2qjGNG7YpSx86oEcNbbHv5Fg9Pw3268PHeJ16bznNMnyGJuea3tuaVdQ2YdXJmGEBemwZQ66ac1VdnWq7PvHymPU4HOeX49PYEiVzfkncKI
NOTCHPAY_PRIVATE_KEY=sk_test.tvagPhM8AfDHTQLMFO1pYWo9qjOBr2FFR3o3VVUWRIvZ9Hg05Ct8IhmbcHbdBfWKOuy4GT8nIEHXRHLAXZFnejom3v39f68c7FxWzHeU1MAO1qOBlHehyAXOm5akH

# OPTION C: CAMPAY (Direct MTN & Orange Money Cameroon API)
# Obtain from: https://campay.net/dashboard
CAMPAY_USERNAME=your_campay_username
CAMPAY_PASSWORD=your_campay_password

# ---------------------------------------------------
# 5. PAYPAL INTEGRATION (OPTIONAL DIRECT CREDENTIALS)
# Obtain from: https://developer.paypal.com/dashboard/applications
# ---------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox # Use 'sandbox' for testing or 'live' for production
